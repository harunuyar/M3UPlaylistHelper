<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.2.0</Version>
    <!-- Allows building (not running) on Linux/macOS, e.g. in CI -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Icon of the .exe (Explorer, taskbar, Start menu). Generated by tools/make_icon.py -->
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon for the title bars of the windows -->
    <EmbeddedResource Include="Resources\AppIcon.ico" LogicalName="AppIcon.ico" />
    <None Remove="Resources\AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\M3UPlaylistHelper.Core\M3UPlaylistHelper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
